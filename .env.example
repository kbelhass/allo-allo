# Copiez ce fichier en ".env" sur le serveur (cp .env.example .env) puis remplissez-le.
# Ne partagez jamais le fichier .env et ne le mettez jamais sur GitHub.

# Nom de domaine (ou sous-domaine) qui pointe vers l'IP publique du serveur Oracle. Ex : alloallo.duckdns.org
DOMAIN=

# Mot de passe de la base PostgreSQL : UNIQUEMENT lettres et chiffres (générez-le avec : openssl rand -hex 24)
POSTGRES_PASSWORD=

# Compte administrateur (connexion vérifiée par le serveur). Sans ces deux lignes, la connexion admin est désactivée.
ADMIN_EMAIL=
ADMIN_PASSWORD=
